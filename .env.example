DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kagounga_cms
PAYLOAD_SECRET=YOUR_SECRET_HERE
NEXT_PUBLIC_CMS_URL=http://localhost:3000
# Satu atau beberapa origin frontend dipisah koma (tanpa spasi wajib).
# Dev default Vite: http://localhost:5173
CORS_ORIGIN=http://localhost:5173
# Media persisten S3/R2 (M7). Kosongkan S3_BUCKET = upload disk lokal (dev).
# R2: S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com, S3_REGION=auto,
#     S3_FORCE_PATH_STYLE=true, S3_PUBLIC_URL=https://<bucket-public-url>
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=
S3_PUBLIC_URL=
# Email transaksional via Resend (M9). Kosong = tulis ke console (dev).
# Prod wajib: RESEND_API_KEY + domain terverifikasi (lihat runbook §G).
RESEND_API_KEY=
RESEND_FROM_ADDRESS=noreply@kagounga.com
RESEND_FROM_NAME=Kagounga
